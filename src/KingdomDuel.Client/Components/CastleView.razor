@using KingdomDuel.Domain
@using KingdomDuel.Shared.Dtos.Matches

<article class="house house-@House @(Mirrored ? "mirrored" : "")">

    <svg class="art" viewBox="0 0 240 170" role="img" aria-label="Cetatea @Name">
        <path class="ground" d="M8 152 H232" />

        <rect class="stone tower" x="44" y="76" width="44" height="76" />
        <rect class="stone" x="48" y="66" width="8" height="10" />
        <rect class="stone" x="62" y="66" width="8" height="10" />
        <rect class="stone" x="76" y="66" width="8" height="10" />

        <rect class="stone keep" x="88" y="56" width="64" height="96" />
        <rect class="stone" x="88" y="46" width="8" height="10" />
        <rect class="stone" x="102" y="46" width="8" height="10" />
        <rect class="stone" x="116" y="46" width="8" height="10" />
        <rect class="stone" x="130" y="46" width="8" height="10" />
        <rect class="stone" x="144" y="46" width="8" height="10" />

        <rect class="stone tower" x="152" y="76" width="44" height="76" />
        <rect class="stone" x="156" y="66" width="8" height="10" />
        <rect class="stone" x="170" y="66" width="8" height="10" />
        <rect class="stone" x="184" y="66" width="8" height="10" />

        <path class="win w1" d="M96 92 V83 A5 5 0 0 1 106 83 V92 Z" />
        <path class="win w2" d="M116 92 V83 A5 5 0 0 1 126 83 V92 Z" />
        <path class="win w3" d="M136 92 V83 A5 5 0 0 1 146 83 V92 Z" />
        <path class="win w4" d="M61 110 V101 A5 5 0 0 1 71 101 V110 Z" />
        <path class="win w5" d="M169 110 V101 A5 5 0 0 1 179 101 V110 Z" />

        <path class="gate" d="M108 152 V128 A12 12 0 0 1 132 128 V152 Z" />
        <path class="bars" d="M114 130 V152 M120 127 V152 M126 130 V152 M110 137 H130 M109 144 H131" />

        @if (Level >= 1)
        {
            <rect class="stone outwall" x="20" y="126" width="200" height="26" />
            <rect class="stone" x="22" y="118" width="9" height="8" />
            <rect class="stone" x="209" y="118" width="9" height="8" />
        }

        @if (Level >= 2)
        {
            <rect class="stone" x="48" y="118" width="9" height="8" />
            <rect class="stone" x="74" y="118" width="9" height="8" />
            <rect class="stone" x="157" y="118" width="9" height="8" />
            <rect class="stone" x="183" y="118" width="9" height="8" />
        }

        @if (WallDown)
        {
            <path class="rubble" d="M18 152 L34 138 L44 150 L58 134 L70 152" />
            <path class="rubble" d="M170 152 L186 136 L198 150 L212 140 L222 152" />
            <path class="crack" d="M100 152 V132 L94 120 L102 108" />
            <path class="crack" d="M140 152 V136 L148 124" />
        }

        <path class="pole" d="M174 66 V14" />
        <path class="banner" d="M174 18 C186 13 196 24 208 19 L208 39 C196 44 186 33 174 38 Z" />
    </svg>

    <div>
        <div class="name-row">
            <div class="who">
                <h2 class="name">@Name</h2>
                @if (IsYou)
                {
                    <span class="tag-you">casa ta</span>
                }
                @if (MissedRounds > 0)
                {
                    <span class="tag-missed"
                          title="Runde ratate. La @GameConstants.MissedRoundsBeforeForfeit, meciul se încheie prin abandon.">
                        @MissedRounds/@GameConstants.MissedRoundsBeforeForfeit ratate
                    </span>
                }
            </div>

            @if (OrderPending is not null)
            {
                <span class="order-state @(OrderPending.Value ? "waiting" : "sent")">
                    @(OrderPending.Value ? "alege" : "ordin trimis")
                </span>
            }
        </div>

        <dl class="stats">
            <div class="stat">
                <dt><Glyph Name="coin" /> Aur</dt>
                <dd class="@(Kingdom is null || Hearsay ? "unknown" : "")">
                    @(Hearsay ? "necunoscut" : Value(Kingdom?.Gold))
                    @if (Moved(Drift?.GoldDelta) is { } goldShift)
                    {
                        <span class="drift @(goldShift > 0 ? "up" : "down")">@Signed(goldShift)</span>
                    }
                </dd>
            </div>
            <div class="stat">
                <dt><Glyph Name="helm" /> Soldați</dt>
                <dd class="@Tone">
                    @Heard(Kingdom?.Troops)
                    @if (Moved(Drift?.TroopsDelta) is { } troopShift)
                    {
                        <span class="drift @(troopShift > 0 ? "up" : "down")">@Signed(troopShift)</span>
                    }
                </dd>
            </div>
            <div class="stat">
                <dt><Glyph Name="folk" /> Săteni</dt>
                <dd class="@Tone">
                    @Heard(Kingdom?.Villagers)
                    @if (Moved(Drift?.VillagersDelta) is { } villageShift)
                    {
                        <span class="drift @(villageShift > 0 ? "up" : "down")">@Signed(villageShift)</span>
                    }
                </dd>
            </div>
            <div class="stat">
                <dt><Glyph Name="flame" /> Moral</dt>
                <dd class="@Tone">
                    @Heard(Kingdom?.Morale)
                    @if (Moved(Drift?.MoraleDelta) is { } moraleShift)
                    {
                        <span class="drift @(moraleShift > 0 ? "up" : "down")">@Signed(moraleShift)</span>
                    }
                </dd>
            </div>
        </dl>

        @if (CanRepairWall)
        {
            <button type="button" class="repair-call" @onclick="OnRepairWall">
                <Glyph Name="shield" />
                <span>@(RepairChosen < 0 ? "Repară zidul" : "Zidul se ridică în runda asta")</span>
                <b>@RepairPrice aur</b>
            </button>
        }
    </div>

</article>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public string House { get; set; } = "amber";

    [Parameter]
    public KingdomDto? Kingdom { get; set; }

    [Parameter]
    public bool Mirrored { get; set; }

    [Parameter]
    public bool IsYou { get; set; }

    [Parameter]
    public bool? OrderPending { get; set; }

    [Parameter]
    public int MissedRounds { get; set; }

    [Parameter]
    public RoundRecapDto? Drift { get; set; }

    [Parameter]
    public bool CanRepairWall { get; set; }

    [Parameter]
    public int RepairChosen { get; set; } = -1;

    [Parameter]
    public EventCallback OnRepairWall { get; set; }

    private int RepairPrice => GameConstants.RepairCost + RepairChosen switch
    {
        1 => GameConstants.RepairToOneCost,
        2 => GameConstants.RepairToTwoCost,
        _ => 0,
    };

    private int Level => Math.Max(0, Kingdom?.Fortification ?? 0);

    private bool WallDown => (Kingdom?.Fortification ?? 0) < 0;

    private static int? Moved(int? amount) => amount is { } shift && shift != 0 ? shift : null;

    private static string Signed(int amount) => amount > 0 ? $"+{amount}" : amount.ToString();

    private bool Hearsay => Kingdom?.IsHearsay == true;

    private string Tone => Kingdom is null ? "unknown" : Hearsay ? "heard" : string.Empty;

    private string Heard(int? amount) =>
        Kingdom is null ? "necunoscut" : Hearsay ? $"~{amount}" : Value(amount);

    private static string Value(int? amount) => amount?.ToString() ?? "necunoscut";
}
