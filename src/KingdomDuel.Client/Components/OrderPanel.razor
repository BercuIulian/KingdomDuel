@using KingdomDuel.Domain
@using KingdomDuel.Domain.Enums
@using KingdomDuel.Domain.Rounds
@using KingdomDuel.Shared.Dtos.Matches
@using KingdomDuel.Shared.Requests.Matches
@using KingdomDuel.Client.ApiClients
@using KingdomDuel.Client.Authentication
@inject ApiClient Api

<section class="orders-wrap">

    <div class="budget">
        <span class="budget-item">
            <Glyph Name="helm" />
            <b>@order.Free</b><span class="eyebrow">soldați liberi din @order.Troops</span>
        </span>
        <span class="budget-item">
            <Glyph Name="folk" />
            <b>@order.FreeVillagers</b><span class="eyebrow">săteni liberi din @order.Villagers</span>
        </span>
        <span class="budget-item">
            <Glyph Name="coin" />
            <b>@order.GoldLeft</b><span class="eyebrow">aur rămas din @order.Gold</span>
        </span>
        @if (order.Caravan is not null)
        {
            <span class="budget-item away">
                <Glyph Name="coin" />
                <span class="eyebrow">caravana e pe drum cu @order.Caravan.Troops, se întoarce în runda @order.Caravan.ReturnsInRound</span>
            </span>
        }

        <button type="button" class="treasury" disabled="@orderSent" @onclick="() => shopOpen = true">
            <Glyph Name="coin" />
            Cumpără
            @if (order.Bought.Count > 0)
            {
                <span class="treasury-count">@order.Bought.Count</span>
            }
        </button>
    </div>

    <div class="orders">
        @foreach (var direction in Directions)
        {
            <button type="button"
                    class="order"
                    aria-pressed="@(order.Allocated(direction) > 0)"
                    disabled="@(orderSent || order.Blocked(direction))"
                    @onclick="() => OpenPicker(direction)">
                <span class="order-ico"><Glyph Name="@Icon(direction)" /></span>
                <b>@Label(direction)</b>
                <small>@Hint(direction)</small>
                @if (order.Allocated(direction) > 0)
                {
                    <span class="shift">@order.Allocated(direction) soldați</span>
                }
            </button>
        }

        <button type="button"
                class="order"
                aria-pressed="@(order.Feast is not null)"
                disabled="@orderSent"
                @onclick="OpenFeast">
            <span class="order-ico"><Glyph Name="flame" /></span>
            <b>Ospăț</b>
            <small>Ridică moralul celor de acasă</small>
            @if (order.Feast is { } chosenTier)
            {
                <span class="shift">@FeastName(chosenTier)</span>
            }
        </button>

        <button type="button"
                class="order"
                aria-pressed="@(order.SpiesOut is not null || order.Spies is not null)"
                disabled="@orderSent"
                @onclick="OpenSpies">
            <span class="order-ico"><Glyph Name="eye" /></span>
            <b>Spioni</b>
            <small>@SpyHint</small>
            @if (SpyShift is { } shift)
            {
                <span class="shift">@shift</span>
            }
        </button>

        <div class="order-action">
            @if (orderSent)
            {
                <p class="order-sent"><Glyph Name="seal" /> Ordin trimis</p>
            }
            else
            {
                <button type="button" class="send" disabled="@(sending || !order.Fits)" @onclick="Send">
                    @(sending ? "Se trimite…" : "Trimite ordinul")
                </button>
            }
            @if (error is not null)
            {
                <p class="send-error">@error</p>
            }
        </div>
    </div>

</section>

@if (picking is { } chosen)
{
    <div class="result-scrim" @onclick="ClosePicker"></div>

    <section class="result picker" role="dialog" aria-modal="true" aria-labelledby="picker-title">
        <span class="result-ico"><Glyph Name="@Icon(chosen)" /></span>
        <h2 id="picker-title">@Label(chosen)</h2>
        <p class="result-text">@Hint(chosen)</p>

        <div class="picker-value">
            <b>@draft</b>
            <span class="eyebrow">din @order.Ceiling(chosen) soldați</span>
        </div>

        <input type="range"
               class="picker-range"
               min="0"
               max="@order.Ceiling(chosen)"
               step="1"
               value="@draft"
               @oninput="OnDraft" />

        @if (chosen == ActionType.Trade)
        {
            <p class="picker-yield">@TradeNote</p>
        }

        <div class="result-actions">
            <button type="button" class="result-ghost" @onclick="() => Withdraw(chosen)">@CancelLabel(chosen)</button>
            <button type="button" class="send" disabled="@(draft == 0)" @onclick="() => Commit(chosen)">Trimite soldați</button>
        </div>
    </section>
}

@if (feastPopup)
{
    <div class="result-scrim" @onclick="CloseFeast"></div>

    <section class="result picker" role="dialog" aria-modal="true" aria-labelledby="feast-title">
        <span class="result-ico"><Glyph Name="flame" /></span>
        <h2 id="feast-title">Ospăț</h2>
        <p class="result-text">Moralul urcă după câți soldați sunt acasă: cei plecați nu petrec.</p>

        <div class="choices">
            @foreach (var tier in Tiers)
            {
                <button type="button"
                        class="choice @(feastDraft == tier ? "chosen" : "")"
                        disabled="@(!order.Affordable(tier))"
                        @onclick="() => feastDraft = tier">
                    <span class="choice-text">
                        <b>@FeastName(tier)</b>
                        <small>+@order.MoraleFrom(tier) moral</small>
                    </span>
                    <span class="choice-price">@GameConstants.FeastCost(tier) aur</span>
                </button>
            }
        </div>

        <div class="result-actions">
            <button type="button" class="result-ghost" @onclick="CallOffFeast">Anulează ospățul</button>
            <button type="button" class="send" disabled="@(feastDraft is null)" @onclick="CommitFeast">Începe ospățul</button>
        </div>
    </section>
}

@if (shopOpen)
{
    <div class="result-scrim" @onclick="() => shopOpen = false"></div>

    <section class="result picker" role="dialog" aria-modal="true" aria-labelledby="shop-title">
        <span class="result-ico"><Glyph Name="coin" /></span>
        <h2 id="shop-title">Cumpără</h2>

        <div class="choices">
            @foreach (var purchase in Buyables)
            {
                <button type="button"
                        class="choice @(order.Bought.Contains(purchase) ? "chosen" : "")"
                        disabled="@(!order.Buyable(purchase))"
                        @onclick="() => order.Toggle(purchase)">
                    <span class="choice-text">
                        <span class="choice-name">
                            <b>@Label(purchase)</b>
                            @if (OrderDraft.MaxLevel(purchase) > 0)
                            {
                                <span class="levels">
                                    @for (var step = 1; step <= OrderDraft.MaxLevel(purchase); step++)
                                    {
                                        <span class="level @LevelState(purchase, step)"></span>
                                    }
                                </span>
                            }
                        </span>
                        <small>@Hint(purchase)</small>
                    </span>
                    <span class="choice-price">@PurchaseNote(purchase)</span>
                </button>
            }
        </div>

        <div class="choices">
            <button type="button" class="choice @(order.Hired > 0 ? "chosen" : "")" @onclick="OpenHire">
                <span class="choice-text">
                    <b>Cumpără săteni</b>
                    <small>Câte @GameConstants.VillagersPerBundle săteni@(order.Hired > 0 ? $", {order.Hired} selectați" : "")</small>
                </span>
                <span class="choice-price">@GameConstants.VillagerBundleCost aur</span>
            </button>

            <button type="button" class="choice @(order.Armed > 0 ? "chosen" : "")"
                    disabled="@(order.Villagers == 0)" @onclick="OpenArm">
                <span class="choice-text">
                    <b>Înarmează săteni</b>
                    <small>@(order.Armed > 0 ? $"{order.Armed} trec în oaste din runda următoare" : " Recrutează soldați din proprii săteni")</small>
                </span>
                <span class="choice-price">@GameConstants.ArmCost aur de cap</span>
            </button>
        </div>
        <div class="result-actions">
            <button type="button" class="send" @onclick="() => shopOpen = false">Gata</button>
        </div>
    </section>
}

@if (hirePopup)
{
    <div class="result-scrim" @onclick="() => hirePopup = false"></div>

    <section class="result picker" role="dialog" aria-modal="true" aria-labelledby="hire-title">
        <span class="result-ico"><Glyph Name="folk" /></span>
        <h2 id="hire-title">Cumpără săteni</h2>
        <p class="result-text">Se cumpără la pachet, de câte ori vrei.</p>

        <div class="picker-value">
            <b>@(draft * GameConstants.VillagersPerBundle)</b>
            <span class="eyebrow">săteni, în @draft pachete</span>
        </div>

        <input type="range" class="picker-range" min="0" max="@order.MaxBundles" step="1" value="@draft" @oninput="OnDraft" />

        <p class="picker-yield">@(draft * GameConstants.VillagerBundleCost) aur</p>

        <div class="result-actions">
            <button type="button" class="result-ghost" @onclick="DropHire">Renunț</button>
            <button type="button" class="send" disabled="@(draft == 0)" @onclick="CommitHire">Cumpăr</button>
        </div>
    </section>
}

@if (armPopup)
{
    <div class="result-scrim" @onclick="() => armPopup = false"></div>

    <section class="result picker" role="dialog" aria-modal="true" aria-labelledby="arm-title">
        <span class="result-ico"><Glyph Name="helm" /></span>
        <h2 id="arm-title">Înarmează săteni</h2>
        <p class="result-text">Cine se înarmează intră în oaste din runda următoare.</p>

        <div class="picker-value">
            <b>@draft</b>
            <span class="eyebrow">din @order.MaxArmed cu putință</span>
        </div>

        <input type="range" class="picker-range" min="0" max="@order.MaxArmed" step="1" value="@draft" @oninput="OnDraft" />

        <p class="picker-yield">@(draft * GameConstants.ArmCost) aur</p>

        <div class="result-actions">
            <button type="button" class="result-ghost" @onclick="DropArm">Renunț</button>
            <button type="button" class="send" disabled="@(draft == 0)" @onclick="CommitArm">Îi înarmez</button>
        </div>
    </section>
}

@if (spyPopup)
{
    <div class="result-scrim" @onclick="() => spyPopup = false"></div>

    <section class="result spies" role="dialog" aria-modal="true" aria-labelledby="spy-title">
        <span class="result-ico"><Glyph Name="eye" /></span>
        <h2 id="spy-title">Spionii</h2>

        <div class="tabs" role="tablist">
            <button type="button" role="tab" class="tab @(hunting ? "" : "picked")"
                    aria-selected="@(!hunting)" @onclick="() => hunting = false">
                Trimite spioni
            </button>
            <button type="button" role="tab" class="tab @(hunting ? "picked" : "")"
                    aria-selected="@hunting" @onclick="() => hunting = true">
                Caută spioni
            </button>
        </div>

        @if (!hunting)
        {
            <p class="result-text">
                Sătenii trimiși ca spioni costă un aur de cap în fiecare rundă. Cu cât sunt mai mulți,
                cu atât vestea vine mai aproape de adevăr.
            </p>

            <div class="choices">
                @foreach (var tier in SpyTiers)
                {
                    <button type="button"
                            class="choice @(order.ChosenSpies == tier ? "chosen" : "")"
                            disabled="@(order.ChosenSpies != tier && !order.CanSendSpies(tier))"
                            @onclick="() => order.PickSpies(tier)">
                        <span class="choice-text">
                            <b>@SpyStaffName(tier)</b>
                            <small>@($"{GameConstants.SpyAccuracy(tier) * 100:0}% precizie · {SpyNote(tier)}")</small>
                        </span>
                        <span class="choice-price">@GameConstants.SpyUpkeep(tier) aur / rundă</span>
                    </button>
                }
            </div>

            @if (State.YourReport is { } report)
            {
                <SpyReportView Report="report" />
            }
            else if (order.SpiesOut is not null)
            {
                <p class="spy-wait">Spionii au plecat. Prima veste sosește runda viitoare.</p>
            }
        }
        else
        {
            <p class="result-text">
                Trimiți soldați să scotocească cetatea. Cine e găsit e ucis, și nu se mai întoarce în satul lui.
            </p>

            <div class="choices">
                @foreach (var tier in HuntTiers)
                {
                    <button type="button"
                            class="choice @(order.Hunt == tier ? "chosen" : "")"
                            disabled="@(GameConstants.HuntSoldiers(tier) > order.FreeForHunt(tier))"
                            @onclick="() => order.PickHunt(tier)">
                        <span class="choice-text">
                            <b>@HuntStaffName(tier)</b>
                            <small>Stinge o rețea de până la nivelul @GameConstants.HuntLevels(tier)</small>
                        </span>
                        <span class="choice-price">@GameConstants.HuntCost(tier) aur</span>
                    </button>
                }
            </div>

            <p class="spy-wait">
                O rețea de nivel @GameConstants.SpyLevel(SpyTier.Ring) sunt cinci spioni, de nivel
                @GameConstants.SpyLevel(SpyTier.Pair) trei, de nivel @GameConstants.SpyLevel(SpyTier.Lone) unul.
                Ce rămâne după scădere rămâne în viață.
            </p>
        }

        <div class="result-actions">
            @if (!hunting && order.SpiesOut is not null)
            {
                <button type="button" class="result-ghost" @onclick="order.CallSpiesHome">Retrage spionii</button>
            }
            @if (hunting && order.Hunt is not null)
            {
                <button type="button" class="result-ghost" @onclick="() => order.Hunt = null">Nu mai caut</button>
            }
            <button type="button" class="send" @onclick="() => spyPopup = false">Gata</button>
        </div>
    </section>
}
@code {
    [Parameter, EditorRequired] public MatchStateDto State { get; set; } = default!;
    [Parameter] public EventCallback<MatchStateDto> OnSubmitted { get; set; }

    [Parameter] public int RepairTo { get; set; } = -1;

    private static readonly ActionType[] Directions = [ActionType.Attack, ActionType.Defend, ActionType.Trade];
    private static readonly PurchaseType[] Standing = [PurchaseType.Recruit, PurchaseType.Fortify, PurchaseType.Catapult];

    private PurchaseType[] Buyables => order.WallDown ? [PurchaseType.Recruit, PurchaseType.Catapult] : Standing;

    private static readonly FeastTier[] Tiers = [FeastTier.Small, FeastTier.Court, FeastTier.Grand];

    private OrderDraft order = default!;
    private FeastTier? feastDraft;

    private ActionType? picking;
    private bool feastPopup;
    private bool shopOpen;
    private int draft;
    private bool hirePopup;
    private bool armPopup;
    private bool spyPopup;
    private bool hunting;

    private int? round;
    private bool sending;
    private bool orderSent;
    private string? error;

    private string TradeNote
    {
        get
        {
            if (draft == 0)
            {
                return "Fără negustori nu vine aur.";
            }

            var (low, high) = GameEngine.TradeRange(draft);

            return low == high ? $"Se întorc cu {low} aur" : $"Se întorc cu {low}–{high} aur";
        }
    }

    protected override void OnParametersSet()
    {
        if (round == State.Round)
        {
            order.State = State;
            order.RepairTo = RepairTo;
            return;
        }

        round = State.Round;
        order = new OrderDraft(State, RepairTo);
        feastDraft = null;
        picking = null;
        feastPopup = false;
        shopOpen = false;
        hirePopup = false;
        armPopup = false;
        spyPopup = false;
        hunting = false;
        orderSent = false;
        error = null;
    }

    private string LevelState(PurchaseType purchase, int step)
    {
        var have = order.Level(purchase);

        if (step <= have)
        {
            return "full";
        }

        return step == have + 1 && order.Bought.Contains(purchase) ? "pending" : string.Empty;
    }

    private void OpenHire()
    {
        draft = order.Hired;
        hirePopup = true;
    }

    private void CommitHire()
    {
        order.Hired = draft;
        hirePopup = false;
    }

    private void DropHire()
    {
        order.Hired = 0;
        hirePopup = false;
    }

    private void OpenArm()
    {
        draft = order.Armed;
        armPopup = true;
    }

    private void CommitArm()
    {
        order.Armed = draft;
        armPopup = false;
    }

    private void DropArm()
    {
        order.Armed = 0;
        armPopup = false;
    }

    private void OpenPicker(ActionType direction)
    {
        draft = order.Allocated(direction);
        picking = direction;
    }

    private void ClosePicker() => picking = null;

    private void OnDraft(ChangeEventArgs args) =>
        draft = int.TryParse(args.Value?.ToString(), out var value) ? value : 0;

    private void Commit(ActionType direction)
    {
        order.Allocate(direction, draft);
        picking = null;
    }

    private void Withdraw(ActionType direction)
    {
        order.Withdraw(direction);
        picking = null;
    }

    private void OpenFeast()
    {
        feastDraft = order.Feast;
        feastPopup = true;
    }

    private string SpyHint => order.SpiesOut is { } ring
        ? $"{SpyStaffName(ring.Tier)} pe teren, {ring.Upkeep} aur pe rundă"
        : "Trimite săteni ca spioni";

    private string? SpyShift
    {
        get
        {
            var moves = new List<string>();

            if (order.RecallSpies) moves.Add("îi chem acasă");
            else if (order.Spies is { } tier) moves.Add(SpyStaffName(tier));

            if (order.Hunt is { } chase) moves.Add($"caut cu {HuntStaffName(chase)}");

            return moves.Count == 0 ? null : string.Join(", ", moves);
        }
    }

    private static readonly SpyTier[] SpyTiers = [SpyTier.Lone, SpyTier.Pair, SpyTier.Ring];

    private static readonly HuntTier[] HuntTiers = [HuntTier.Scout, HuntTier.Patrol, HuntTier.Sweep];

    private static string HuntStaffName(HuntTier tier) =>
        GameConstants.HuntSoldiers(tier) is var many && many == 1 ? "1 soldat" : $"{many} soldați";

    private static string SpyStaffName(SpyTier tier) =>
        GameConstants.SpyVillagers(tier) is var many && many == 1 ? "1 sătean" : $"{many} săteni";

    private static string SpyNote(SpyTier tier) => tier switch
    {
        SpyTier.Lone => "vești aproximative, la un preț mic",
        SpyTier.Pair => "cifre mai apropiate de adevăr",
        _ => "aproape exact, și îi afli și ordinele din runda trecută",
    };

    private void OpenSpies() => spyPopup = true;

    private void CloseFeast() => feastPopup = false;

    private void CommitFeast()
    {
        order.Feast = feastDraft;
        feastPopup = false;
    }

    private void CallOffFeast()
    {
        order.Feast = null;
        feastDraft = null;
        feastPopup = false;
    }

    private string PurchaseNote(PurchaseType purchase) =>
        order.AtMax(purchase) ? "la maximum" : $"{GameConstants.PurchaseCost(purchase)} aur";

    private async Task Send()
    {
        sending = true;
        error = null;

        try
        {
            var state = await Api.SubmitOrderAsync(order.ToRequest(), State.Code);

            orderSent = true;
            await OnSubmitted.InvokeAsync(state);
        }
        catch (ApiException exception)
        {
            error = ApiErrorReader.Describe(exception, "Ordinul n-a fost primit.");
        }
        finally
        {
            sending = false;
        }
    }

    private static string Label(ActionType direction) => direction switch
    {
        ActionType.Attack => "Atac",
        ActionType.Defend => "Apărare",
        _ => "Comerț",
    };

    private string Hint(ActionType direction) => direction switch
    {
        ActionType.Attack => "Atacă cetatea adversarului",
        ActionType.Defend => order.WallDown
            ? "Zidul e dărâmat, n-are cine să-l țină"
            : $"Pe ziduri urcă cel mult {GameEngine.WallCapacity(order.Mine?.Fortification ?? 0)}",
        _ => order.Caravan is null ? "Sătenii pleacă la negoț, se întorc peste o rundă" : "Caravana e deja pe drum",
    };

    private static string CancelLabel(ActionType direction) => direction switch
    {
        ActionType.Attack => "Anulează atacul",
        ActionType.Defend => "Anulează apărarea",
        _ => "Anulează comerțul",
    };

    private static string Icon(ActionType direction) => direction switch
    {
        ActionType.Attack => "sword",
        ActionType.Defend => "shield",
        _ => "coin",
    };

    private static string Label(PurchaseType purchase) => purchase switch
    {
        PurchaseType.Recruit => "Recrutare",
        PurchaseType.Fortify => "Fortificație",
        PurchaseType.Repair => "Ridică zidul",
        PurchaseType.RepairToOne => "Și înapoi la nivelul 1",
        PurchaseType.RepairToTwo => "Și înapoi la nivelul 2",
        _ => "Catapultă",
    };

    private static string Hint(PurchaseType purchase) => purchase switch
    {
        PurchaseType.Recruit => $"Recrutează {GameConstants.RecruitTroops} soldați pentru runda următoare",
        PurchaseType.Fortify => $"Zid mai trainic: +{GameConstants.FortifySeconds}s, +{GameConstants.FortifyArchers} arcași",
        PurchaseType.Repair => "Cetatea are iar ziduri, la nivelul de bază",
        PurchaseType.RepairToOne => "Cât ține oferta, treapta pierdută se ia ieftin",
        PurchaseType.RepairToTwo => "Cât ține oferta, amândouă treptele se iau ieftin",
        _ => $"Spargi zidul cu {GameConstants.CatapultSeconds}s mai repede",
    };

    private static string FeastName(FeastTier tier) => tier switch
    {
        FeastTier.Small => "Masă mică",
        FeastTier.Court => "Ospăț de curte",
        _ => "Ospăț mare",
    };
}
