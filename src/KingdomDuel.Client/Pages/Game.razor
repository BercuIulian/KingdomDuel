@page "/game"
@attribute [Authorize]
@layout GameLayout
@using KingdomDuel.Client.ApiClients
@using KingdomDuel.Domain.Enums
@using KingdomDuel.Shared.Dtos.Matches
@implements IAsyncDisposable
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>Meci — Kingdom Duel</PageTitle>


@if (error is not null)
{
    <section class="table-message">
        <p class="error-text">@error</p>
        <button type="button" class="send" @onclick="GoHome">Înapoi la meniu</button>
    </section>
}
else if (state is null)
{
    <section class="table-message">
        <p class="loading-text">Se așază piesele pe masă…</p>
    </section>
}
else
{
    <section class="table">

        <header class="head">
            <span class="crest"><Glyph Name="swords" /></span>

            <h1>@Heading</h1>

            <div class="head-round">
                <span class="eyebrow">Runda</span>
                <span class="round-value">@state.Round<span>/@state.TotalRounds</span></span>
            </div>

            <RulesBook />

            <div class="code">
                <span class="eyebrow">Cod</span>
                <b>@(string.IsNullOrWhiteSpace(DisplayCode) ? "••••••" : DisplayCode)</b>
            </div>

            @if (CanPlay && state.Status == MatchStatus.InProgress)
            {
                <button type="button" class="leave" @onclick="AskLeave">Părăsește</button>
            }
        </header>

        <section class="arena @(state.Status == MatchStatus.InProgress ? "duel" : "")">
            <CastleView House="amber"
                        Name="@Player1Name"
                        Kingdom="state.Player1Kingdom"
                        IsYou="Side == 1"
                        Drift="@(Side == 1 ? state.LastRound : null)"
                        MissedRounds="state.Player1MissedRounds" />

            @if (state.Status != MatchStatus.InProgress)
            {
                <PowerScale Power1="state.Player1Kingdom?.TotalPower ?? 0"
                            Power2="state.Player2Kingdom?.TotalPower ?? 0"
                            Name1="@Player1Name"
                            Name2="@Player2Name" />
            }

            <CastleView House="steel"
                        Name="@Player2Name"
                        Kingdom="state.Player2Kingdom"
                        Mirrored="true"
                        IsYou="Side == 2"
                        Drift="@(Side == 2 ? state.LastRound : null)"
                        MissedRounds="state.Player2MissedRounds" />
        </section>

        <div class="timer-row">
            @if (state.Status == MatchStatus.InProgress)
            {
                <RoundTimer SecondsRemaining="state.SecondsRemaining" RoundSeconds="state.RoundSeconds" />
            }
        </div>

        @if (CanPlay && state.Status == MatchStatus.InProgress)
        {
            @if (state.Battle is { } battle)
            {
                <BattleView Battle="battle"
                            Code="@state.Code"
                            YourSide="Side"
                            Player1Name="@Player1Name"
                            Player2Name="@Player2Name"
                            OnChanged="OnOrderSubmitted" />
            }
            else if (state.March is { } march)
            {
                <MarchView March="march" Code="@state.Code" OnChanged="OnOrderSubmitted" />
            }
            else
            {
                <OrderPanel State="state" OnSubmitted="OnOrderSubmitted" />
            }
        }

        @if (state.Status == MatchStatus.Completed)
        {
            <section class="verdict">
                <span class="verdict-ico"><Glyph Name="crown" /></span>
                <p class="verdict-text">@VerdictText</p>
                <button type="button" class="send" disabled="@leaving" @onclick="LeaveAndGoHome">
                    @(leaving ? "Se iese…" : "Înapoi la meniu")
                </button>
            </section>
        }

    </section>

    @if (recapOpen && state.LastRound is { } recap)
    {
        <RoundRecap Recap="recap" OnClosed="() => recapOpen = false" />
    }

    @if (confirmingLeave)
    {
        <div class="result-scrim" @onclick="CancelLeave"></div>

        <section class="result confirm"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="confirm-title"
                 tabindex="-1"
                 @ref="confirmPanel"
                 @onkeydown="OnConfirmKeyDown">

            <h2 id="confirm-title">Părăsești meciul?</h2>
            <p class="result-text">
                Meciul se încheie pe loc, iar @OpponentName câștigă prin abandon.
                Nu te mai poți întoarce la masa asta.
            </p>

            <div class="result-actions">
                <button type="button" class="result-ghost" @onclick="CancelLeave">Rămân în meci</button>
                <button type="button" class="send danger" disabled="@leaving" @onclick="LeaveAndGoHome">
                    @(leaving ? "Se iese…" : "Părăsesc meciul")
                </button>
            </div>
        </section>
    }

    @if (state.Status == MatchStatus.Completed && !resultDismissed)
    {
        <div class="result-scrim"></div>

        <section class="result @ResultClass"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="result-title"
                 tabindex="-1"
                 @ref="resultPanel">

            <span class="result-ico"><Glyph Name="crown" /></span>
            <span class="eyebrow">@ResultEyebrow</span>
            <h2 id="result-title">@ResultHeadline</h2>
            <p class="result-text">@VerdictText</p>

            <div class="result-scores">
                <div class="score @(WinnerSide == 1 ? "win" : "") @(Side == 1 ? "you" : "")">
                    <span class="score-name">@Player1Name</span>
                    <b class="score-power">@(state.Player1Kingdom?.TotalPower ?? 0)</b>
                    <span class="eyebrow">putere</span>
                    <span class="score-detail">@KingdomSummary(state.Player1Kingdom)</span>
                </div>
                <div class="score @(WinnerSide == 2 ? "win" : "") @(Side == 2 ? "you" : "")">
                    <span class="score-name">@Player2Name</span>
                    <b class="score-power">@(state.Player2Kingdom?.TotalPower ?? 0)</b>
                    <span class="eyebrow">putere</span>
                    <span class="score-detail">@KingdomSummary(state.Player2Kingdom)</span>
                </div>
            </div>

            @if (state.Story is { Rounds.Count: > 1 } story)
            {
                <MatchStory Story="story" Player1Name="@Player1Name" Player2Name="@Player2Name" />
            }

            <div class="result-actions">
                <button type="button" class="result-ghost" @onclick="DismissResult">Închide</button>
                <button type="button" class="send" disabled="@leaving" @onclick="LeaveAndGoHome">
                    @(leaving ? "Se iese…" : "Înapoi la meniu")
                </button>
            </div>
        </section>
    }
}

@code {
    [SupplyParameterFromQuery(Name = Routes.CodeParameter)]
    public string? Code { get; set; }

    private int Side => state?.YourSide ?? 0;

    private MatchStateDto? state;
    private string? error;
    private bool resultDismissed;
    private bool recapOpen;
    private int recapShown;
    private bool leaving;
    private bool resultFocused;

    private ElementReference resultPanel;
    private bool confirmingLeave;
    private bool confirmFocused;
    private ElementReference confirmPanel;

    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(2);

    private static readonly TimeSpan LivePollInterval = TimeSpan.FromSeconds(1);
    private readonly CancellationTokenSource pollCts = new();

    private string? DisplayCode => state?.Code ?? Code;

    private bool CanPlay => Side is 1 or 2;

    private string Player1Name =>
        string.IsNullOrWhiteSpace(state?.Player1Name) ? "Jucătorul 1" : state!.Player1Name!;

    private string Player2Name =>
        string.IsNullOrWhiteSpace(state?.Player2Name) ? "Jucătorul 2" : state!.Player2Name!;

    private string Heading =>
        state?.Status == MatchStatus.Completed ? "Meciul s-a încheiat" : "Masa de război";

    // ---------- Finalul meciului ----------

    private int WinnerSide => state?.GameOverReason switch
    {
        GameOverReason.Player2CastleDestroyed
            or GameOverReason.RoundsExhaustedPlayer1Wins
            or GameOverReason.Player2Left
            or GameOverReason.Player2Disconnected => 1,
        GameOverReason.Player1CastleDestroyed
            or GameOverReason.RoundsExhaustedPlayer2Wins
            or GameOverReason.Player1Left
            or GameOverReason.Player1Disconnected => 2,
        _ => 0,
    };

    private bool IsPlayer => Side is 1 or 2;

    private string ResultClass
    {
        get
        {
            if (WinnerSide == 0) return "draw";
            if (!IsPlayer) return "neutral";
            return WinnerSide == Side ? "won" : "lost";
        }
    }

    private string ResultHeadline
    {
        get
        {
            if (WinnerSide == 0)
            {
                return state!.GameOverReason is GameOverReason.BothDisconnected
                    ? "Fără învingător"
                    : "Egalitate";
            }

            if (!IsPlayer)
            {
                return WinnerSide == 1 ? $"{Player1Name} câștigă" : $"{Player2Name} câștigă";
            }

            return WinnerSide == Side ? "Victorie" : "Înfrângere";
        }
    }

    private string ResultEyebrow => state!.GameOverReason switch
    {
        GameOverReason.Player1CastleDestroyed
            or GameOverReason.Player2CastleDestroyed => "Cetate dărâmată",
        GameOverReason.Player1Left or GameOverReason.Player2Left => "Meci încheiat prin abandon",
        GameOverReason.Player1Disconnected or GameOverReason.Player2Disconnected => "Meci încheiat prin inactivitate",
        GameOverReason.BothDisconnected => "Ambele tabere au încetat să dea ordine",
        _ => $"Rundele s-au epuizat · {state.TotalRounds} runde",
    };

    private string OpponentName => Side == 1 ? Player2Name : Player1Name;

    private void AskLeave()
    {
        confirmingLeave = true;
        confirmFocused = false;
    }

    private void CancelLeave() => confirmingLeave = false;

    private void OnConfirmKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CancelLeave();
        }
    }

    private static string KingdomSummary(KingdomDto? kingdom) => kingdom is null
        ? "—"
        : $"{kingdom.Gold} aur · {kingdom.Troops} trupe · {kingdom.Morale} moral";

    private void DismissResult() => resultDismissed = true;

    private void OnOrderSubmitted(MatchStateDto fresh)
    {
        state = fresh;
        OfferRecap(fresh);
    }

    private void OfferRecap(MatchStateDto fresh)
    {
        if (fresh.LastRound is not { } recap || recap.Round == recapShown)
        {
            return;
        }

        recapShown = recap.Round;
        recapOpen = RoundRecap.WorthTelling(recap);
    }

    private async Task LeaveAndGoHome()
    {
        if (leaving)
        {
            return;
        }

        leaving = true;

        if (CanPlay && !string.IsNullOrWhiteSpace(Code))
        {
            try
            {
                await Api.LeaveMatchAsync(Code);
            }
            catch
            {
                // Chiar dacă serverul nu răspunde, jucătorul tot pleacă la meniu.
            }
        }

        await pollCts.CancelAsync();
        Navigation.NavigateTo(Routes.Play);
    }

    private string VerdictText => state!.GameOverReason switch
    {
        GameOverReason.Player1CastleDestroyed => $"{Player2Name} câștigă: cetatea lui {Player1Name} a fost dărâmată.",
        GameOverReason.Player2CastleDestroyed => $"{Player1Name} câștigă: cetatea lui {Player2Name} a fost dărâmată.",
        GameOverReason.RoundsExhaustedPlayer1Wins => $"{Player1Name} câștigă la putere, după {state.TotalRounds} runde.",
        GameOverReason.RoundsExhaustedPlayer2Wins => $"{Player2Name} câștigă la putere, după {state.TotalRounds} runde.",
        GameOverReason.RoundsExhaustedDraw => $"Egalitate după {state.TotalRounds} runde.",
        GameOverReason.Player1Left => $"{Player1Name} a părăsit meciul. {Player2Name} câștigă prin abandon.",
        GameOverReason.Player2Left => $"{Player2Name} a părăsit meciul. {Player1Name} câștigă prin abandon.",
        GameOverReason.Player1Disconnected => $"{Player1Name} este inactiv, {Player2Name} câștigă.",
        GameOverReason.Player2Disconnected => $"{Player2Name} este inactiv, {Player1Name} câștigă.",
        GameOverReason.BothDisconnected => "Ambii jucători sunt inactivi. Meciul se încheie fără învingător.",
        _ => "Meciul s-a încheiat.",
    };

    // ---------- Ciclul de viață ----------

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Code))
        {
            error = "Lipsește codul meciului.";
            return;
        }

        await LoadStateAsync();

        recapShown = state?.LastRound?.Round ?? 0;

        if (error is null)
        {
            _ = PollLoopAsync(pollCts.Token);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (confirmingLeave && !confirmFocused)
        {
            confirmFocused = true;
            await confirmPanel.FocusAsync();
            return;
        }

        if (!resultFocused && state?.Status == MatchStatus.Completed && !resultDismissed)
        {
            resultFocused = true;
            await resultPanel.FocusAsync();
        }
    }

    private void GoHome() => Navigation.NavigateTo(Routes.Play);

    private async Task LoadStateAsync()
    {
        try
        {
            state = await Api.GetMatchAsync(Code!);
        }
        catch (ApiException ex) when (ex.StatusCode == 404)
        {
            error = "Meciul nu a fost găsit.";
        }
        catch (ApiException ex)
        {
            error = $"Nu am putut încărca meciul (cod {ex.StatusCode}).";
        }
        catch (Exception)
        {
            error = "Nu am putut contacta serverul.";
        }
    }

    private async Task PollLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(PollInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                try
                {
                    var fresh = await Api.GetMatchAsync(Code!, ct);

                    if (state is not null && fresh.Round < state.Round)
                    {
                        continue;
                    }

                    state = fresh;
                    OfferRecap(fresh);
                    timer.Period = fresh.Battle is not null || fresh.March is not null
                        ? LivePollInterval
                        : PollInterval;

                    await InvokeAsync(StateHasChanged);

                    if (fresh.Status == MatchStatus.Completed)
                    {
                        return;
                    }
                }
                catch (OperationCanceledException)
                {
                    throw;
                }
                catch (ApiException ex) when (ex.StatusCode == 404)
                {
                    error = "Meciul a fost închis.";
                    await InvokeAsync(StateHasChanged);
                    return;
                }
                catch
                {
                    // Ignorăm erorile tranzitorii de rețea; următorul tick reîncearcă.
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Componenta a fost distrusă; oprim polling-ul în liniște.
        }
    }

    public async ValueTask DisposeAsync()
    {
        await pollCts.CancelAsync();
        pollCts.Dispose();
    }
}
