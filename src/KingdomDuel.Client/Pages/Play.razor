@page "/play"
@attribute [Authorize]
@using KingdomDuel.Client.ApiClients
@using KingdomDuel.Shared.Dtos.Matches
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>Kingdom Duel</PageTitle>

<section class="hero">
    <div class="crest"><Glyph Name="swords" /></div>
    <h1>Kingdom Duel</h1>
    <p class="tagline">Două regate. Un duel. Un singur învingător.</p>

    <AuthorizeView>
        <Authorized>
            <p class="welcome">Bun venit, @context.User.Identity?.Name</p>
        </Authorized>
    </AuthorizeView>

    @if (activeMatch is not null)
    {
        <div class="active-match">
            <div class="active-info">
                <span class="active-title"><Glyph Name="hourglass" /> Meci în desfășurare</span>
                <span class="active-round">
                    <strong>@activeMatch.Code</strong> · runda @activeMatch.Round din @activeMatch.TotalRounds
                </span>
            </div>
            <button type="button" class="btn-resume" @onclick="Resume">Continuă →</button>
        </div>
    }

    <div class="join-row">
        <button type="button" class="btn-check" title="Alătură-te meciului"
                disabled="@isBusy" @onclick="JoinMatch">
            @(isBusy ? "…" : "✓")
        </button>
        <input type="text"
               class="code-input"
               placeholder="Codul meciului"
               maxlength="12"
               disabled="@isBusy"
               @bind="matchCode"
               @bind:event="oninput"
               @onkeydown="OnCodeKeyDown" />
    </div>

    @if (joinError is not null)
    {
        <p class="join-error">@joinError</p>
    }

    <button type="button" class="btn-create" disabled="@isBusy" @onclick="CreateMatch">Creează meci</button>
</section>

@if (isWarning && activeMatch is not null)
{
    <div class="modal-scrim" @onclick="DismissWarning"></div>

    <section class="modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="active-match-title"
             tabindex="-1"
             @ref="warningPanel"
             @onkeydown="OnWarningKeyDown">

        <span class="modal-ico"><Glyph Name="hourglass" /></span>
        <h2 id="active-match-title">Ai deja un meci în desfășurare</h2>
        <p class="modal-text">
            Meciul <strong>@activeMatch.Code</strong> e la runda @activeMatch.Round din
            @activeMatch.TotalRounds. Nu poți juca două meciuri deodată. Dacă îl părăsești,
            se încheie pe loc și adversarul câștigă prin abandon.
        </p>

        @if (warningError is not null)
        {
            <p class="modal-error">@warningError</p>
        }

        <div class="modal-actions">
            <button type="button" class="btn-resume" disabled="@isBusy" @onclick="Resume">
                Reintră în meci
            </button>
            <button type="button" class="btn-abandon" disabled="@isBusy" @onclick="AbandonMatch">
                @(isBusy ? "Se iese…" : "Părăsește meciul")
            </button>
        </div>
    </section>
}

@code {
    private string matchCode = string.Empty;
    private bool isBusy;
    private string? joinError;

    private ActiveMatchDto? activeMatch;
    private bool isWarning;
    private bool warningFocused;
    private string? warningError;
    private ElementReference warningPanel;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            activeMatch = (await Api.GetMyMatchAsync()).Match;
        }
        catch (Exception)
        {
            // Cardul lipsește, restul paginii funcționează. Un 401 e tratat de BearerTokenHandler.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (isWarning && !warningFocused)
        {
            warningFocused = true;
            await warningPanel.FocusAsync();
        }
    }

    private void CreateMatch()
    {
        if (isBusy)
        {
            return;
        }

        if (activeMatch is not null)
        {
            Warn();
            return;
        }

        Navigation.NavigateTo(Routes.Lobby);
    }

    private async Task OnCodeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await JoinMatch();
        }
    }

    private async Task JoinMatch()
    {
        var code = matchCode.Trim();

        if (code.Length == 0 || isBusy)
        {
            return;
        }

        if (activeMatch is not null)
        {
            if (code.Equals(activeMatch.Code, StringComparison.OrdinalIgnoreCase))
            {
                Resume();
            }
            else
            {
                Warn();
            }

            return;
        }

        await JoinAsync(code);
    }

    private void Warn()
    {
        isWarning = true;
        warningFocused = false;
        warningError = null;
        joinError = null;
    }

    private void DismissWarning()
    {
        if (!isBusy)
        {
            isWarning = false;
        }
    }

    private void OnWarningKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            DismissWarning();
        }
    }

    private void Resume()
    {
        if (activeMatch is not null)
        {
            Navigation.NavigateTo(Routes.GameFor(activeMatch.Code));
        }
    }

    private async Task AbandonMatch()
    {
        if (activeMatch is null || isBusy)
        {
            return;
        }

        isBusy = true;
        warningError = null;

        try
        {
            await Api.LeaveMatchAsync(activeMatch.Code);
        }
        catch (Exception)
        {
            warningError = "Nu am putut părăsi meciul. Încearcă din nou.";
            return;
        }
        finally
        {
            isBusy = false;
        }

        activeMatch = null;
        isWarning = false;
    }

    private async Task JoinAsync(string code)
    {
        isBusy = true;
        joinError = null;

        try
        {
            await Api.JoinMatchAsync(code);
            Navigation.NavigateTo(Routes.LobbyFor(code));
        }
        catch (ApiException ex)
        {
            joinError = ex.StatusCode switch
            {
                404 => "Cod invalid sau meciul nu există.",
                _ => ApiErrorReader.Describe(ex, $"Nu ne-am putut alătura meciului (cod {ex.StatusCode})."),
            };
        }
        catch (Exception)
        {
            joinError = "Nu am putut contacta serverul.";
        }
        finally
        {
            isBusy = false;
        }
    }
}
