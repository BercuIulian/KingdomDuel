@page "/"
@inject NavigationManager Navigation

<PageTitle>Kingdom Duel</PageTitle>

<section class="hero">
    <div class="crest">⚔️</div>
    <h1>Kingdom Duel</h1>
    <p class="tagline">Două regate. Opt runde. Un singur învingător.</p>

    <div class="join-row">
        <button type="button" class="btn-check" title="Alătură-te meciului">✓</button>
        <input type="text"
               class="code-input"
               placeholder="Codul meciului"
               @bind="matchCode" />
    </div>

    <button type="button" class="btn-create" @onclick="CreateMatch">Crează meci</button>
</section>

@code {
    private string matchCode = string.Empty;

    private void CreateMatch() => Navigation.NavigateTo("/lobby");
}
